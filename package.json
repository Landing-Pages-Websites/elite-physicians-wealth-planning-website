{
  "name": "elite-physicians-wealth-planning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:palette": "node scripts/check-palette.mjs",
    "verify": "node scripts/verify-pages.mjs",
    "check:contrast": "node scripts/check-text-contrast.mjs && python3 scripts/score-text-contrast.py",
    "verify:all": "NEXT_DIST_DIR=.next-verify next build && (NEXT_DIST_DIR=.next-verify next start -p 3100 & echo $! > /tmp/epwp-verify.pid) && sleep 7 && npm run check:palette && npm run verify && npm run check:contrast; kill $(cat /tmp/epwp-verify.pid) 2>/dev/null; rm -f /tmp/epwp-verify.pid",
    "prebuild": "node scripts/guard-build.mjs",
    "test:mega-preview": "node --test --experimental-strip-types src/mega-preview/*.test.mjs scripts/preview-wiring.test.mjs"
  },
  "dependencies": {
    "next": "^15.5.4",
    "posthog-js": "^1.438.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
